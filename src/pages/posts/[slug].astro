---
// Canonical post page in Japanese. The site is JA-first so JA gets the
// bare /posts/<slug> URL; EN translations are served from
// src/pages/posts/[slug]/en.astro at /posts/<slug>/en.
import Post from '../../layouts/Post.astro';
import {
  loadAllPosts,
  findTranslation,
  type LocalizedPost,
} from '../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await loadAllPosts();
  const jaPosts = allPosts.filter((post) => post.lang === 'ja');
  return jaPosts.map((post) => {
    const translation = findTranslation(allPosts, post.slug, 'en');
    return {
      params: { slug: post.slug },
      props: { post, translation },
    };
  });
}

type Props = { post: LocalizedPost; translation: LocalizedPost | undefined };

const { post, translation } = Astro.props as Props;
const { Content } = await post.entry.render();
---
<Post
  post={post.entry}
  lang={post.lang}
  translationSlug={translation?.slug}
  translationLang={translation?.lang}
>
  <Content />
</Post>
