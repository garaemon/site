---
import Post from '../../layouts/Post.astro';
import {
  loadAllPosts,
  filterByLang,
  findTranslation,
  postUrl,
  homeUrl,
  type LocalizedPost,
} from '../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await loadAllPosts();
  const jaPosts = filterByLang(allPosts, 'ja');
  return jaPosts.map((post) => {
    const translation = findTranslation(allPosts, post.slug, 'en');
    const langSwitchHref = translation ? postUrl(post.slug, 'en') : homeUrl('en');
    return {
      params: { slug: post.slug },
      props: { post, langSwitchHref },
    };
  });
}

type Props = { post: LocalizedPost; langSwitchHref: string };

const { post, langSwitchHref } = Astro.props as Props;
const { Content } = await post.entry.render();
---
<Post post={post.entry} lang="ja" langSwitchHref={langSwitchHref}>
  <Content />
</Post>
