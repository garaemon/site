---
// All-posts index at /posts. Renders one PostList per pubDate year, newest year first.
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import {
  loadAllPosts,
  sortByPubDateDesc,
  type LocalizedPost,
} from '../../lib/posts';

const allPosts = await loadAllPosts();
const sortedPosts = sortByPubDateDesc(allPosts);

const postsByYear = new Map<number, LocalizedPost[]>();
for (const post of sortedPosts) {
  const year = post.entry.data.pubDate.getFullYear();
  const bucket = postsByYear.get(year) ?? [];
  bucket.push(post);
  postsByYear.set(year, bucket);
}

const yearGroups = [...postsByYear.entries()].sort(([a], [b]) => b - a);
---
<Base title="Posts">
  <h1>Posts</h1>
  {yearGroups.map(([year, posts]) => (
    <section>
      <h2>{year}</h2>
      <PostList posts={posts} />
    </section>
  ))}
</Base>
