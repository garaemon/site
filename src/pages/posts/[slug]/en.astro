---
// English translation page at /posts/<slug>/en. Mirrors the JA canonical
// page in src/pages/posts/[slug].astro but for EN entries. EN-only
// posts (no JA counterpart) also live here, with no bare /posts/<slug>
// URL.
import Post from '../../../layouts/Post.astro';
import {
  loadAllPosts,
  findTranslation,
  type LocalizedPost,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await loadAllPosts();
  const enPosts = allPosts.filter((post) => post.lang === 'en');
  return enPosts.map((post) => {
    const translation = findTranslation(allPosts, post.slug, 'ja');
    return {
      params: { slug: post.slug },
      props: { post, translation },
    };
  });
}

type Props = { post: LocalizedPost; translation: LocalizedPost | undefined };

const { post, translation } = Astro.props as Props;
const { Content } = await post.entry.render();
---
<Post
  post={post.entry}
  lang={post.lang}
  translationSlug={translation?.slug}
  translationLang={translation?.lang}
>
  <Content />
</Post>
