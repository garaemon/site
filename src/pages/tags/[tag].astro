---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import {
  loadAllPosts,
  filterByLang,
  sortByPubDateDesc,
  collectTags,
  tagsIndexUrl,
  homeUrl,
  type LocalizedPost,
} from '../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await loadAllPosts();
  const jaPosts = filterByLang(allPosts, 'ja');
  return [...collectTags(jaPosts).keys()].map((tag) => {
    const taggedPosts = sortByPubDateDesc(
      jaPosts.filter((post) => post.entry.data.tags.includes(tag))
    );
    return {
      params: { tag },
      props: { tag, posts: taggedPosts },
    };
  });
}

type Props = { tag: string; posts: LocalizedPost[] };

const { tag, posts } = Astro.props as Props;
---
<Base title={`#${tag}`} lang="ja" langSwitchHref={homeUrl('en')}>
  <h1>#{tag}</h1>
  <p><a href={tagsIndexUrl('ja')}>&larr; all tags</a></p>
  <PostList posts={posts} />
</Base>
