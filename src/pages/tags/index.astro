---
// /tags — lists every tag sorted by post count (descending), then alphabetically.
import Base from '../../layouts/Base.astro';
import { loadAllPosts, collectTags, tagUrl } from '../../lib/posts';

const allPosts = await loadAllPosts();
const tagCounts = collectTags(allPosts);
const sortedTags = [...tagCounts.entries()].sort((a, b) => {
  if (b[1] !== a[1]) {
    return b[1] - a[1];
  }
  return a[0].localeCompare(b[0]);
});
---
<Base title="Tags">
  <h1>Tags</h1>
  {sortedTags.length === 0 ? (
    <p>No tags yet.</p>
  ) : (
    <ul class="list-none p-0 flex flex-wrap gap-y-2 gap-x-4">
      {sortedTags.map(([tag, count]) => (
        <li>
          <a class="no-underline text-muted hover:text-accent hover:underline" href={tagUrl(tag)}>#{tag}</a>
          <span class="text-muted text-[0.85em] ml-1">({count})</span>
        </li>
      ))}
    </ul>
  )}
</Base>
