---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import {
  loadAllPosts,
  filterByLang,
  sortByPubDateDesc,
  homeUrl,
  postsIndexUrl,
  aboutUrl,
} from '../../lib/posts';

const HOME_POST_LIMIT = 10;
const LANG = 'en';
const allPosts = await loadAllPosts();
const recentPosts = sortByPubDateDesc(filterByLang(allPosts, LANG)).slice(0, HOME_POST_LIMIT);
---
<Base lang={LANG} langSwitchHref={homeUrl('ja')}>
  <section class="overflow-hidden">
    <img
      src="https://github.com/garaemon.png"
      alt="garaemon"
      width="96"
      height="96"
      loading="eager"
      class="rounded-full w-24 h-24 float-left mr-4 mb-2"
    />
    <p>
      A machine that consumes pop culture and outputs code.
      Notes on Emacs, macOS, Go, and whatever else I'm hacking on.
      See <a href={aboutUrl(LANG)}>about</a> for a longer intro.
    </p>
  </section>
  <section>
    <h2>Recent posts</h2>
    <PostList posts={recentPosts} />
    <p><a href={postsIndexUrl(LANG)}>all posts &rarr;</a></p>
  </section>
</Base>
