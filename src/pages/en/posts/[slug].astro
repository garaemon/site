---
import Post from '../../../layouts/Post.astro';
import {
  loadAllPosts,
  filterByLang,
  findTranslation,
  postUrl,
  homeUrl,
  type LocalizedPost,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const all = await loadAllPosts();
  const enPosts = filterByLang(all, 'en');
  return enPosts.map((post) => {
    const translation = findTranslation(all, post.slug, 'ja');
    const langSwitchHref = translation ? postUrl(post.slug, 'ja') : homeUrl('ja');
    return {
      params: { slug: post.slug },
      props: { post, langSwitchHref },
    };
  });
}

type Props = { post: LocalizedPost; langSwitchHref: string };

const { post, langSwitchHref } = Astro.props as Props;
const { Content } = await post.entry.render();
---
<Post post={post.entry} lang="en" langSwitchHref={langSwitchHref}>
  <Content />
</Post>
