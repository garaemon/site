---
import Base from '../../layouts/Base.astro';
import { loadPage, aboutUrl } from '../../lib/posts';

const LANG = 'en';
const page = await loadPage('about', LANG);
const { Content } = await page.render();
---
<Base title={page.data.title} description={page.data.description} lang={LANG} langSwitchHref={aboutUrl('ja')}>
  <article>
    <h1>{page.data.title}</h1>
    <Content />
  </article>
</Base>
