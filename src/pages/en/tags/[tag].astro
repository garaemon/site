---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import {
  loadAllPosts,
  filterByLang,
  sortByPubDateDesc,
  collectTags,
  tagsIndexUrl,
  homeUrl,
  type LocalizedPost,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await loadAllPosts();
  const enPosts = filterByLang(allPosts, 'en');
  return [...collectTags(enPosts).keys()].map((tag) => {
    const taggedPosts = sortByPubDateDesc(
      enPosts.filter((post) => post.entry.data.tags.includes(tag))
    );
    return {
      params: { tag },
      props: { tag, posts: taggedPosts },
    };
  });
}

type Props = { tag: string; posts: LocalizedPost[] };

const { tag, posts } = Astro.props as Props;
---
<Base title={`#${tag}`} lang="en" langSwitchHref={homeUrl('ja')}>
  <h1>#{tag}</h1>
  <p><a href={tagsIndexUrl('en')}>&larr; all tags</a></p>
  <PostList posts={posts} />
</Base>
