---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import {
  loadAllPosts,
  filterByLang,
  sortByPubDateDesc,
  tagsIndexUrl,
  homeUrl,
  type LocalizedPost,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const all = await loadAllPosts();
  const en = filterByLang(all, 'en');
  const tagSet = new Set<string>();
  for (const post of en) {
    for (const tag of post.entry.data.tags) {
      tagSet.add(tag);
    }
  }
  return [...tagSet].map((tag) => {
    const taggedPosts = sortByPubDateDesc(
      en.filter((post) => post.entry.data.tags.includes(tag))
    );
    return {
      params: { tag },
      props: { tag, posts: taggedPosts },
    };
  });
}

type Props = { tag: string; posts: LocalizedPost[] };

const { tag, posts } = Astro.props as Props;
---
<Base title={`#${tag}`} lang="en" langSwitchHref={homeUrl('ja')}>
  <h1>#{tag}</h1>
  <p><a href={tagsIndexUrl('en')}>&larr; all tags</a></p>
  <PostList posts={posts} />
</Base>
