---
import Base from '../../../layouts/Base.astro';
import {
  loadAllPosts,
  filterByLang,
  collectTags,
  tagUrl,
  homeUrl,
} from '../../../lib/posts';

const LANG = 'en';
const all = await loadAllPosts();
const langPosts = filterByLang(all, LANG);
const tagCounts = collectTags(langPosts);
const sortedTags = [...tagCounts.entries()].sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});
---
<Base title="tags" lang={LANG} langSwitchHref={homeUrl('ja')}>
  <h1>tags</h1>
  {sortedTags.length === 0 ? (
    <p>No tags yet.</p>
  ) : (
    <ul class="tag-cloud">
      {sortedTags.map(([tag, count]) => (
        <li>
          <a href={tagUrl(tag, LANG)}>#{tag}</a>
          <span class="tag-count">({count})</span>
        </li>
      ))}
    </ul>
  )}
</Base>
