---
// Home page (/). A short intro plus the most recent N posts.
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { loadAllPosts, sortByPubDateDesc } from '../lib/posts';

const HOME_POST_LIMIT = 10;
const allPosts = await loadAllPosts();
const recentPosts = sortByPubDateDesc(allPosts).slice(0, HOME_POST_LIMIT);
---
<Base>
  <section class="flex items-center gap-4">
    <img
      src="https://github.com/garaemon.png"
      alt="garaemon"
      width="96"
      height="96"
      loading="eager"
      class="rounded-full w-24 h-24 shrink-0 m-0!"
    />
    <p class="m-0!">
      I love pop culture and writing codes.
      See <a href="/about">about</a> for a longer intro.
    </p>
  </section>
  <section>
    <h2>Recent posts</h2>
    <PostList posts={recentPosts} />
    <p><a href="/posts">all posts &rarr;</a></p>
  </section>
</Base>
