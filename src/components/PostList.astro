---
import { formatDate } from '../utils/date';
import { type LocalizedPost, postUrl } from '../lib/posts';

type Props = {
  posts: LocalizedPost[];
};

const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => (
    <li>
      <time datetime={post.entry.data.pubDate.toISOString()}>{formatDate(post.entry.data.pubDate)}</time>
      <a href={postUrl(post.slug, post.lang)}>{post.entry.data.title}</a>
    </li>
  ))}
</ul>
