---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, otherLang, rssUrl } from '../lib/posts';

type Props = {
  title?: string;
  description?: string;
  lang: Lang;
  langSwitchHref: string;
};

const { title, description, lang, langSwitchHref } = Astro.props;
const siteName = 'garaemon';
const pageTitle = title ? `${title} - ${siteName}` : siteName;
// TODO: replace JA with a real Japanese description once finalised.
const defaultDescriptionByLang: Record<Lang, string> = {
  ja: 'A machine that consumes pop culture and outputs code.',
  en: 'A machine that consumes pop culture and outputs code.',
};
const metaDescription = description ?? defaultDescriptionByLang[lang];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const altLangHref = new URL(langSwitchHref, Astro.site).toString();
const feedHref = rssUrl(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={otherLang(lang)} href={altLangHref} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} feed`} href={feedHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header lang={lang} langSwitchHref={langSwitchHref} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
