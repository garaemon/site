---
import Base from './Base.astro';
import { formatDate } from '../utils/date';
import { type Lang, type Post, tagUrl } from '../lib/posts';

type Props = {
  post: Post;
  lang: Lang;
  langSwitchHref: string;
};

const { post, lang, langSwitchHref } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---
<Base title={title} description={description} lang={lang} langSwitchHref={langSwitchHref}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            {' '}&middot; updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </>
        )}
        {tags.length > 0 && (
          <span class="post-tags">
            {tags.map((tag) => (
              <a href={tagUrl(tag, lang)}>#{tag}</a>
            ))}
          </span>
        )}
      </p>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</Base>
