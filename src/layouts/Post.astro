---
import Base from './Base.astro';
import { formatDate } from '../utils/date';
import { type Lang, type Post, tagUrl } from '../lib/posts';

type Props = {
  post: Post;
  lang: Lang;
  langSwitchHref: string;
};

const { post, lang, langSwitchHref } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---
<Base title={title} description={description} lang={lang} langSwitchHref={langSwitchHref}>
  <article>
    <header>
      <h1 class="mb-[0.25em]">{title}</h1>
      <p class="text-muted text-[0.9em] mb-8">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            {' '}&middot; updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </>
        )}
        {tags.length > 0 && (
          <span class="ml-2">
            {tags.map((tag) => (
              <a class="text-muted no-underline mr-2 hover:text-accent hover:underline" href={tagUrl(tag, lang)}>#{tag}</a>
            ))}
          </span>
        )}
      </p>
    </header>
    <div class="[&_img]:block [&_img]:my-[1.2em] [&_img]:mx-auto">
      <slot />
    </div>
  </article>
</Base>
